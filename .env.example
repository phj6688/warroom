# War Room, Environment Configuration
#
# After the Infisical migration, the only value docker compose actually
# reads from this file is INFISICAL_PROJECT_ID. Every other secret listed
# below now lives in Infisical (project d3075986-e619-4df9-a2e0-345e8b8f62e8)
# and is injected at runtime by docker/entrypoint.sh via the Infisical CLI.
# The rest of this file is kept as documentation of what keys the app reads.

# ── Infisical ───────────────────────────────────────────────
INFISICAL_PROJECT_ID=<paste from Infisical UI>

# ── LLM Backend (pick one) ──────────────────────────────────

# Option A: OpenAI-compatible Gateway (recommended for homelab)
OPENAI_BASE_URL=http://your-gateway:18789
# OPENAI_API_KEY — populate locally; .env is gitignored.
# NEVER place this value in docker-compose.yml or any tracked file.
OPENAI_API_KEY=
MODEL=claude-opus-4-7

# Option B: Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-4-5

# ── Search (optional) ───────────────────────────────────────
# Enables Research Scout live web search.
# TAVILY_API_KEY=tvly-...
# SEARCH_MAX_RESULTS=5
#
# Provider selector. Default: tavily.
#   tavily  — Tavily API only (requires TAVILY_API_KEY)
#   smart   — self-hosted SearXNG + DuckDuckGo, no API cost, no LLM eval
#   coexist — smart first; fall back to Tavily on empty/error
# SEARCH_PROVIDER=tavily
#
# SearXNG URL for smart/coexist. In Docker, host.docker.internal:9090 works
# via the extra_hosts host-gateway in docker-compose.yml. Override if you
# attach war-room to SearXNG's own docker network.
# SEARXNG_URL=http://host.docker.internal:9090
#
# Scout transport: prose markers (legacy, default) vs Anthropic tool_use.
# Flip after the tool_use path has baked in canary. Both paths share the
# same provider dispatcher; only the transport differs.
# SCOUT_USE_TOOL=false
#
# Grant web_search to tier-B (red-teamer, quantitative-expert) and tier-C
# specialists (legal, medical, financial, security, policy). Independent of
# SCOUT_USE_TOOL — scout's flag stays separate so tiers can canary alone.
# AGENT_SEARCH_EXPANSION=false
#
# Total queries any single deliberation can issue across all search-enabled
# agents. Beyond this cap, further tool calls receive a terminal tool_result
# telling the agent to synthesize with what it has.
# SESSION_QUERY_BUDGET=30

# ── Quality Evaluation ──────────────────────────────────────
# Haiku-class model for quality evaluator and adversarial twin (cost-efficient)
# QUALITY_MODEL=anthropic/claude-haiku-4-5

# ── Server ──────────────────────────────────────────────────
PORT=8090

# ── Auth ────────────────────────────────────────────────────
# WAR_ROOM_TOKEN gates every /api/* endpoint and the WebSocket upgrade.
# Unset = unauthenticated mode (server logs a loud warning at boot).
# Generate with: openssl rand -hex 32
# WAR_ROOM_TOKEN=

# ── Embeddings (memory system) ──────────────────────────────
# Local Ollama instance for embedding generation
# EMBEDDING_URL=http://localhost:11434/api/embed
# EMBEDDING_MODEL=nomic-embed-text

# ── MCP ─────────────────────────────────────────────────────
# WAR_ROOM_URL is used by the stdio MCP server to connect to the
# War Room HTTP/WS API. Default: http://localhost:8090
# For co-located deployment this default is correct.
# WAR_ROOM_URL=http://localhost:8090
# MCP_API_KEY=your-mcp-api-key  # auto-generated if not set

# ── Files-service (optional file attachments) ───────────────
# External files-service handles upload/extraction/tokenization. Leave both
# unset to disable file attachments — War Room runs fine without them.
# FILES_SERVICE_URL=http://localhost:9100
# FILES_SERVICE_TOKEN=

# ── Deployment: Traefik (optional) ──────────────────────────
# Public hostname for the Traefik router label in docker-compose.yml. Only
# relevant if you route War Room through Traefik. Default: warroom.localhost
# WARROOM_HOST=warroom.example.com
