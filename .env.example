# War Room — Environment Configuration

# ── LLM Backend (pick one) ──────────────────────────────────

# Option A: OpenAI-compatible Gateway (recommended for homelab)
OPENAI_BASE_URL=http://your-gateway:18789
# OPENAI_API_KEY — populate locally; .env is gitignored.
# NEVER place this value in docker-compose.yml or any tracked file.
OPENAI_API_KEY=
MODEL=claude-opus-4-7

# Option B: Direct Anthropic API
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-4-5

# ── Search (optional) ───────────────────────────────────────
# Enables Research Scout live web search via Tavily
# TAVILY_API_KEY=tvly-...
# SEARCH_MAX_RESULTS=5

# ── Quality Evaluation ──────────────────────────────────────
# Haiku-class model for quality evaluator and adversarial twin (cost-efficient)
# QUALITY_MODEL=anthropic/claude-haiku-4-5

# ── Server ──────────────────────────────────────────────────
PORT=8090

# ── Auth ────────────────────────────────────────────────────
# WAR_ROOM_TOKEN gates every /api/* endpoint and the WebSocket upgrade.
# Unset = unauthenticated mode (server logs a loud warning at boot).
# Generate with: openssl rand -hex 32
# WAR_ROOM_TOKEN=

# ── Embeddings (memory system) ──────────────────────────────
# Local Ollama instance for embedding generation
# EMBEDDING_URL=http://localhost:11434/api/embed
# EMBEDDING_MODEL=nomic-embed-text

# ── MCP ─────────────────────────────────────────────────────
# WAR_ROOM_URL is used by the stdio MCP server to connect to the
# War Room HTTP/WS API. Default: http://localhost:8090
# For co-located deployment this default is correct.
# WAR_ROOM_URL=http://localhost:8090
# MCP_API_KEY=your-mcp-api-key  # auto-generated if not set
